{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@guanghe-pub/clawhub-pak": ["../clawhub/dist/cli.d.ts"],
      "@guanghe-pub/clawhub-pak/*": ["../clawhub/dist/*"]
    },
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
